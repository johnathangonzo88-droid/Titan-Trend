# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Telegram ---
# Create a bot with @BotFather on Telegram to get a token.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Chat/channel/group ID(s) signals are broadcast to, comma-separated.
# Use @userinfobot or the bot's getUpdates response to find chat IDs.
TELEGRAM_CHAT_IDS=-1001234567890

# --- Data source for live signal generation ---
# Set to "csv" to replay the provided historical CSVs (for testing),
# or "broker" to plug in a real-time feed (implement in src/data_layer/live_feed.py).
LIVE_DATA_SOURCE=csv

# --- Optional: broker/data vendor API credentials (fill in if LIVE_DATA_SOURCE=broker) ---
BROKER_API_KEY=
BROKER_API_SECRET=

# --- Environment ---
ENV=development
